{
  "info": {
    "_postman_id": "6d1f5b8e-4f2a-4c9e-9b7d-2a1c3e5f7a90",
    "name": "Vuelos Management API",
    "description": "Colección de pruebas para la API de gestión de vuelos y usuarios.\n\nIncluye los flujos de salud, autenticación JWT, CRUDL de usuarios y CRUDL de vuelos, con validación de roles ADMIN y REVIEWER.\n\nAntes de ejecutar: iniciar la aplicación y ajustar la variable de entorno `baseUrl` si es necesario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Admin1234!" },
    { "key": "userId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "userName", "value": "Postman User" },
    { "key": "userEmail", "value": "postman.user@example.com" },
    { "key": "vueloId", "value": "vuelo-postman-001" },
    { "key": "vueloNumero", "value": "AV9001" },
    { "key": "fechaCompra", "value": "2026-01-10T08:00:00" },
    { "key": "fechaSalida", "value": "2026-12-15T10:30:00" },
    { "key": "fechaLlegada", "value": "2026-12-15T13:45:00" }
  ],
  "item": [
    {
      "name": "00 - Salud",
      "item": [
        {
          "name": "Estado del servicio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Endpoint público que confirma que la API está en ejecución."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Estado UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica al administrador sembrado por schema.sql y guarda el token JWT en la variable `token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve accessToken', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login inválido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"ClaveIncorrecta1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Verifica que credenciales inválidas respondan 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credenciales inválidas responden 401', () => pm.response.to.have.status(401));",
                  "pm.test('Cuerpo de error con status 401', () => pm.expect(pm.response.json().status).to.eql(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Usuarios",
      "item": [
        {
          "name": "Eliminar usuario de prueba (limpieza)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            },
            "description": "Elimina un usuario previo con el mismo ID para que la colección sea re-ejecutable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Limpieza idempotente (204 o 404)', () => pm.expect([204, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{userId}}\",\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Secure123!\",\n  \"role\": \"MEMBER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Registra un usuario con rol MEMBER. El alta es pública."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario creado', () => pm.response.to.have.status(201));",
                  "pm.test('ID correcto', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('userId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Lista todos los usuarios. Requiere rol ADMIN o REVIEWER."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado exitoso', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta es un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            },
            "description": "Consulta un usuario por su ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consulta exitosa', () => pm.response.to.have.status(200));",
                  "pm.test('ID coincide', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('userId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User Updated\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Secure456!\",\n  \"role\": \"REVIEWER\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            },
            "description": "Actualiza nombre, rol y estado del usuario. Requiere rol ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualización exitosa', () => pm.response.to.have.status(200));",
                  "pm.test('Rol actualizado', () => pm.expect(pm.response.json().role).to.eql('REVIEWER'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            },
            "description": "Elimina el usuario de prueba. Requiere rol ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario eliminado', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Vuelos",
      "item": [
        {
          "name": "Eliminar vuelo de prueba (limpieza)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/vuelos/{{vueloId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vuelos", "{{vueloId}}"]
            },
            "description": "Elimina un vuelo previo con el mismo ID para que la colección sea re-ejecutable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Limpieza idempotente (204 o 404)', () => pm.expect([204, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear vuelo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{vueloId}}\",\n  \"fechaCompra\": \"{{fechaCompra}}\",\n  \"fechaSalida\": \"{{fechaSalida}}\",\n  \"fechaLlegada\": \"{{fechaLlegada}}\",\n  \"agenciaViajes\": \"Agencia Caribe\",\n  \"aerolinea\": \"Avianca\",\n  \"numero\": \"{{vueloNumero}}\",\n  \"valor\": 450000.00,\n  \"cliente\": \"Carlos Perez\",\n  \"puesto\": \"12A\",\n  \"avion\": \"Airbus A320\",\n  \"aeropuertoSalida\": \"Aeropuerto Rafael Nunez\",\n  \"aeropuertoLlegada\": \"Aeropuerto El Dorado\",\n  \"piloto\": \"Capitan Juan Gomez\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vuelos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vuelos"]
            },
            "description": "Crea un vuelo. Requiere rol ADMIN y guarda el ID retornado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Vuelo creado', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Estado inicial PROGRAMADO', () => pm.expect(body.estado).to.eql('PROGRAMADO'));",
                  "pm.collectionVariables.set('vueloId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear vuelo duplicado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{vueloId}}-dup\",\n  \"fechaCompra\": \"{{fechaCompra}}\",\n  \"fechaSalida\": \"{{fechaSalida}}\",\n  \"fechaLlegada\": \"{{fechaLlegada}}\",\n  \"agenciaViajes\": \"Agencia Caribe\",\n  \"aerolinea\": \"Avianca\",\n  \"numero\": \"{{vueloNumero}}\",\n  \"valor\": 450000.00,\n  \"cliente\": \"Carlos Perez\",\n  \"puesto\": \"12A\",\n  \"avion\": \"Airbus A320\",\n  \"aeropuertoSalida\": \"Aeropuerto Rafael Nunez\",\n  \"aeropuertoLlegada\": \"Aeropuerto El Dorado\",\n  \"piloto\": \"Capitan Juan Gomez\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vuelos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vuelos"]
            },
            "description": "Intenta crear un vuelo con la misma combinación número + fecha de salida + puesto y espera 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Conflicto por clave única', () => pm.response.to.have.status(409));",
                  "pm.test('Cuerpo de error con status 409', () => pm.expect(pm.response.json().status).to.eql(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar vuelos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/vuelos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vuelos"]
            },
            "description": "Lista los vuelos ordenados por fecha de salida."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado exitoso', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta es un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener vuelo por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/vuelos/{{vueloId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vuelos", "{{vueloId}}"]
            },
            "description": "Consulta un vuelo por su ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consulta exitosa', () => pm.response.to.have.status(200));",
                  "pm.test('ID coincide', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('vueloId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar vuelo",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaCompra\": \"{{fechaCompra}}\",\n  \"fechaSalida\": \"{{fechaSalida}}\",\n  \"fechaLlegada\": \"{{fechaLlegada}}\",\n  \"agenciaViajes\": \"Agencia Caribe\",\n  \"aerolinea\": \"Avianca\",\n  \"numero\": \"{{vueloNumero}}\",\n  \"estado\": \"CONFIRMADO\",\n  \"valor\": 470000.00,\n  \"cliente\": \"Carlos Perez\",\n  \"puesto\": \"12A\",\n  \"avion\": \"Airbus A320\",\n  \"aeropuertoSalida\": \"Aeropuerto Rafael Nunez\",\n  \"aeropuertoLlegada\": \"Aeropuerto El Dorado\",\n  \"piloto\": \"Capitan Juan Gomez\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vuelos/{{vueloId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vuelos", "{{vueloId}}"]
            },
            "description": "Actualiza el vuelo y cambia su estado a CONFIRMADO. Requiere rol ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualización exitosa', () => pm.response.to.have.status(200));",
                  "pm.test('Estado CONFIRMADO', () => pm.expect(pm.response.json().estado).to.eql('CONFIRMADO'));",
                  "pm.test('Valor actualizado', () => pm.expect(pm.response.json().valor).to.eql(470000.00));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar vuelo",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
