# =============================================
# Copia este archivo como .env y ajusta los valores.
# El archivo .env está ignorado por git y no debe publicarse.
# =============================================

# Servidor
PORT=8080

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vuelos_management
DB_USERNAME=root
DB_PASSWORD=
DB_SSL_MODE=DISABLED

# Correo SMTP (opcional en desarrollo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Gestion de Vuelos

# Seguridad JWT
# En producción reemplace este valor por un secreto aleatorio de al menos 32 bytes en Base64.
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LW11c3QtYmUtcmVwbGFjZWQ=
JWT_EXPIRATION_SECONDS=900
